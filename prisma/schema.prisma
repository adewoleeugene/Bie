generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


// ─── Enums ───────────────────────────────────────────────

enum OrgPlan {
  FREE
  PRO
  ENTERPRISE
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum SprintStatus {
  PLANNING
  ACTIVE
  COMPLETED
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  ARCHIVED
}

enum TaskPriority {
  P0
  P1
  P2
  P3
}

enum ActivityAction {
  STATUS_CHANGE
  ASSIGNED
  EDITED
  COMMENTED
}

enum FocusSessionType {
  POMODORO
  FREE
}

enum TimeEntrySource {
  MANUAL
  FOCUS_SESSION
}

enum WikiNamespace {
  COMPANY
  PROJECT
}

enum NotificationType {
  MENTION
  DUE_SOON
  OVERDUE
  ASSIGNED
  COMMENT
  ACCESS_REQUEST
  ACCESS_GRANTED
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  DENIED
}

enum AttachmentParent {
  TASK
  COMMENT
  WIKI_PAGE
  MESSAGE
  DATABASE_ROW
}

enum MentionTargetType {
  USER
  WIKI_PAGE
  DATE
  EVERYONE
}

enum DatabasePropertyType {
  TEXT
  NUMBER
  SELECT
  MULTI_SELECT
  DATE
  CHECKBOX
  PERSON
  URL
  EMAIL
  IMAGE
  RELATION
  ROLLUP
  STATUS
  FORMULA
}

enum DatabaseViewType {
  TABLE
  BOARD
  GALLERY
  CALENDAR
  TIMELINE
}

enum ResourceVisibility {
  ORG
  ORG_VIEW
  PRIVATE
}

enum ResourceMemberRole {
  VIEWER
  EDITOR
}

// ─── Models ──────────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  plan      OrgPlan  @default(FREE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members       OrganizationMember[]
  projects      Project[]
  squads        Squad[]
  tasks         Task[]
  sprints       Sprint[]
  wikiPages     WikiPage[]
  notifications Notification[]
  favorites     Favorite[]
  recentItems   RecentItem[]
  wikiTemplates WikiTemplate[]
  notificationPreferences NotificationPreference[]
  conversations Conversation[]
  attachments   Attachment[]
  databases     WikiDatabase[]
  reflections   DailyReflection[]
  milestones    Milestone[]
  privacyRequests PrivacyRequest[]
}

model User {
  id        String   @id @default(cuid())
  name      String
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  memberships    OrganizationMember[]
  squadMembers   SquadMember[]
  taskAssignees  TaskAssignee[]
  comments       Comment[]
  activities     TaskActivity[]
  focusSessions  FocusSession[]
  timeEntries    TimeEntry[]
  wikiPages      WikiPage[]       @relation("WikiPageAuthor")
  wikiEdits      WikiPageVersion[] @relation("WikiPageEditor")
  notifications  Notification[]
  projectsLed    Project[]        @relation("ProjectLead")
  favorites      Favorite[]
  recentItems    RecentItem[]
  accounts       Account[]
  sessions       Session[]
  createdAutomationRules AutomationRule[]
  wikiTemplates WikiTemplate[] @relation("WikiTemplateAuthor")
  notificationPreferences NotificationPreference[]
  conversationMembers ConversationMember[]
  messages Message[]
  attachments Attachment[]
  blockComments BlockComment[] @relation("BlockCommentAuthor")
  createdDatabases WikiDatabase[] @relation("WikiDatabaseCreator")
  wikiPageViews  WikiPageAnalytics[] @relation("WikiPageViewer")
  reflections    DailyReflection[]  @relation("DailyReflectionAuthor")
  databaseMemberships WikiDatabaseMember[] @relation("WikiDatabaseMemberUser")
  wikiPageMemberships WikiPageMember[] @relation("WikiPageMemberUser")
  wikiAccessRequests WikiPageAccessRequest[] @relation("WikiPageAccessRequester")
  assistantMessages AssistantMessage[] @relation("AssistantMessageUser")
  privacyRequests PrivacyRequest[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model OrganizationMember {
  organizationId String
  userId         String
  role           OrgRole  @default(MEMBER)
  joinedAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([organizationId, userId])
  @@index([userId])
}

model Squad {
  id             String   @id @default(cuid())
  name           String
  description    String?
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      SquadMember[]
  projects     Project[]

  @@index([organizationId])
}

model SquadMember {
  squadId  String
  userId   String
  joinedAt DateTime @default(now())

  squad Squad @relation(fields: [squadId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([squadId, userId])
  @@index([userId])
}

model Project {
  id             String        @id @default(cuid())
  name           String
  description    String?
  status         ProjectStatus @default(ACTIVE)
  organizationId String
  leadId         String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         User?        @relation("ProjectLead", fields: [leadId], references: [id], onDelete: SetNull)
  squads       Squad[]
  sprints      Sprint[]
  tasks        Task[]
  wikiPages    WikiPage[]
  automationRules AutomationRule[]
  milestones   Milestone[]

  @@index([organizationId])
}

model Sprint {
  id             String       @id @default(cuid())
  name           String
  goal           String?
  startDate      DateTime
  endDate        DateTime
  status         SprintStatus @default(PLANNING)
  retrospective  String?
  organizationId String
  projectId      String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks        Task[]

  @@index([organizationId])
  @@index([projectId])
}

model Task {
  id             String       @id @default(cuid())
  title          String
  description    Json?
  status         TaskStatus   @default(BACKLOG)
  priority       TaskPriority @default(P2)
  dueDate        DateTime?
  startDate      DateTime?
  estimatedHours Float?
  labels         String[]     @default([])
  sortOrder      Int          @default(0)
  organizationId String
  projectId      String?
  sprintId       String?
  parentTaskId   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  sprint       Sprint?        @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  parentTask   Task?          @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: SetNull)
  subtasks     Task[]         @relation("TaskSubtasks")
  assignees    TaskAssignee[]
  comments     Comment[]
  activities   TaskActivity[]
  focusSessions FocusSession[]
  timeEntries  TimeEntry[]

  @@index([organizationId])
  @@index([projectId])
  @@index([sprintId])
  @@index([status])
  @@index([parentTaskId])
}

model TaskAssignee {
  taskId     String
  userId     String
  assignedAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  taskId    String
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model TaskActivity {
  id        String         @id @default(cuid())
  taskId    String
  userId    String
  action    ActivityAction
  metadata  Json?
  createdAt DateTime       @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model FocusSession {
  id            String           @id @default(cuid())
  userId        String
  taskId        String?
  startedAt     DateTime
  endedAt       DateTime?
  duration      Int?
  type          FocusSessionType @default(POMODORO)
  pomodoroCount Int              @default(0)
  notes         String?
  completed     Boolean          @default(false)
  createdAt     DateTime         @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([taskId])
}

model TimeEntry {
  id          String          @id @default(cuid())
  userId      String
  taskId      String
  startedAt   DateTime
  endedAt     DateTime?
  duration    Int?
  description String?
  source      TimeEntrySource @default(MANUAL)
  createdAt   DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([taskId])
}

model WikiPage {
  id             String        @id @default(cuid())
  title          String
  icon           String?       /// Emoji or icon identifier (e.g. "📄", "rocket")
  coverImage     String?       /// URL of the page cover image
  content        Json?
  namespace      WikiNamespace @default(COMPANY)
  organizationId String
  projectId      String?
  parentPageId   String?
  authorId       String
  sortOrder      Int           @default(0)
  template       Boolean       @default(false)
  published      Boolean       @default(false)
  slug           String?       @unique
  allowDuplicate Boolean       @default(false)
  disallowIndexing Boolean     @default(false)
  visibility     ResourceVisibility @default(ORG_VIEW)
  /// Soft-delete marker.
  deletedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parentPage   WikiPage?       @relation("WikiPageTree", fields: [parentPageId], references: [id], onDelete: SetNull)
  childPages   WikiPage[]      @relation("WikiPageTree")
  author       User            @relation("WikiPageAuthor", fields: [authorId], references: [id])
  versions     WikiPageVersion[]
  mentions     WikiMention[]   @relation("WikiMentionSource")
  blockComments BlockComment[] @relation("WikiPageBlockComments")
  members      WikiPageMember[]
  analytics    WikiPageAnalytics[]
  accessRequests WikiPageAccessRequest[]

  @@index([organizationId])
  @@index([projectId])
  @@index([parentPageId])
}

/// Google-Docs-style "request edit access". A view-only user asks for access to
/// a page; the owner (or an org admin) approves — granting a WikiPageMember role
/// of their choosing — or denies.
model WikiPageAccessRequest {
  id        String              @id @default(cuid())
  pageId    String
  userId    String
  status    AccessRequestStatus @default(PENDING)
  message   String?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  page WikiPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  user User     @relation("WikiPageAccessRequester", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pageId, userId])
  @@index([pageId, status])
  @@index([userId])
}

model DailyReflection {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  date           DateTime /// Normalized to start-of-day UTC
  content        String   @default("")
  mood           Int?     /// 1–5 scale (1=rough, 5=great)
  energyLevel    Int?     /// 1–5 scale
  highlights     String?  /// What went well
  improvements   String?  /// What to do better tomorrow
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation("DailyReflectionAuthor", fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@index([organizationId])
}

model WikiPageAnalytics {
  id         String   @id @default(cuid())
  pageId     String
  userId     String
  viewedAt   DateTime @default(now())

  page WikiPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  user User     @relation("WikiPageViewer", fields: [userId], references: [id], onDelete: Cascade)

  @@index([pageId])
  @@index([userId])
  @@index([pageId, userId])
}

model WikiPageMember {
  id        String             @id @default(cuid())
  pageId    String
  userId    String
  role      ResourceMemberRole @default(EDITOR)
  createdAt DateTime           @default(now())

  page WikiPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  user User     @relation("WikiPageMemberUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pageId, userId])
  @@index([userId])
}

model WikiTemplate {
  id             String   @id @default(cuid())
  name           String
  description    String?
  content        Json
  organizationId String
  authorId       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author       User         @relation("WikiTemplateAuthor", fields: [authorId], references: [id])

  @@index([organizationId])
}

model WikiPageVersion {
  id         String   @id @default(cuid())
  pageId     String
  content    Json
  editedById String
  createdAt  DateTime @default(now())

  page     WikiPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  editedBy User     @relation("WikiPageEditor", fields: [editedById], references: [id])

  @@index([pageId])
}

model Notification {
  id             String           @id @default(cuid())
  userId         String
  organizationId String
  type           NotificationType
  title          String
  body           String?
  linkUrl        String?
  read           Boolean          @default(false)
  createdAt      DateTime         @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([organizationId])
}

model Favorite {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  itemType       String   // "project" | "task" | "wiki_page"
  itemId         String
  itemTitle      String
  itemUrl        String
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, itemType, itemId])
  @@index([userId])
  @@index([organizationId])
}

model RecentItem {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  itemType       String   // "project" | "task" | "wiki_page"
  itemId         String
  itemTitle      String
  itemUrl        String
  visitedAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, itemType, itemId])
  @@index([userId])
  @@index([organizationId])
}

model Conversation {
    id             String   @id @default(cuid())
    name           String?
    isGroup        Boolean  @default(false)
    organizationId String
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt

    organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    members      ConversationMember[]
    messages     Message[]

    @@index([organizationId])
}

model ConversationMember {
    conversationId String
    userId         String
    joinedAt       DateTime @default(now())
    lastReadAt     DateTime @default(now())

    conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
    user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@id([conversationId, userId])
    @@index([userId])
}

model Message {
    id             String   @id @default(cuid())
    body           String
    conversationId String
    senderId       String
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt

    conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
    sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

    @@index([conversationId, createdAt])
    @@index([senderId])
}

model NotificationPreference {
    id             String           @id @default(cuid())
    userId         String
    organizationId String
    type           NotificationType
    inApp          Boolean          @default(true)
    email          Boolean          @default(false)

    user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
    organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

    @@unique([userId, organizationId, type])
    @@index([userId])
}

model Attachment {
  id             String           @id @default(cuid())
  organizationId String
  uploaderId     String
  parentType     AttachmentParent
  parentId       String
  key            String           // S3 object key
  filename       String
  mimeType       String
  size           Int
  width          Int?
  height         Int?
  ready          Boolean          @default(false)
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploader     User         @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([parentType, parentId])
  @@index([uploaderId])
}

model WikiDatabase {
  id             String             @id @default(cuid())
  name           String
  description    String?
  organizationId String
  createdById    String
  visibility     ResourceVisibility @default(ORG)
  /// Soft-delete marker. Non-null = in trash. Null = active.
  deletedAt      DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User                 @relation("WikiDatabaseCreator", fields: [createdById], references: [id], onDelete: Cascade)
  properties   DatabaseProperty[]
  rows         DatabaseRow[]
  views        DatabaseView[]
  members      WikiDatabaseMember[]

  @@index([organizationId])
}

model WikiDatabaseMember {
  id         String             @id @default(cuid())
  databaseId String
  userId     String
  role       ResourceMemberRole @default(EDITOR)
  createdAt  DateTime           @default(now())

  database WikiDatabase @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  user     User         @relation("WikiDatabaseMemberUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([databaseId, userId])
  @@index([userId])
}

model DatabaseProperty {
  id         String               @id @default(cuid())
  databaseId String
  name       String
  type       DatabasePropertyType
  config     Json?
  sortOrder  Int                  @default(0)
  createdAt  DateTime             @default(now())

  database  WikiDatabase           @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  values    DatabaseValue[]
  relations DatabaseRowRelation[]

  @@index([databaseId])
}

model DatabaseRow {
  id         String   @id @default(cuid())
  databaseId String
  sortOrder  Int      @default(0)
  /// BlockNote document for the row's long-form body. Notion-style: every
  /// row is a first-class page with both properties and a content area.
  content    Json?
  /// Cached rollup results, keyed by ROLLUP property id. Invalidated by
  /// `cleanRollupCacheForRow` whenever a write could change the result.
  /// Schema: { [rollupPropertyId]: RollupValue }
  rollupCache Json?
  /// Soft-delete marker.
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  database          WikiDatabase          @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  values            DatabaseValue[]
  relationsFrom     DatabaseRowRelation[] @relation("RelationFromRow")
  relationsTo       DatabaseRowRelation[] @relation("RelationToRow")

  @@index([databaseId])
}

/// Edge in a relation between two rows. The `propertyId` always refers to a
/// RELATION property living on the *source* (from) database. Reading "all
/// rows that point to row X via property P" is just a query on
/// `(toRowId, propertyId)` and is the basis for rollups.
model DatabaseRowRelation {
  id         String @id @default(cuid())
  propertyId String
  fromRowId  String
  toRowId    String

  property DatabaseProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  fromRow  DatabaseRow      @relation("RelationFromRow", fields: [fromRowId], references: [id], onDelete: Cascade)
  toRow    DatabaseRow      @relation("RelationToRow", fields: [toRowId], references: [id], onDelete: Cascade)

  @@unique([propertyId, fromRowId, toRowId])
  @@index([fromRowId, propertyId])
  @@index([toRowId, propertyId])
}

model DatabaseValue {
  id         String @id @default(cuid())
  rowId      String
  propertyId String
  value      Json

  row      DatabaseRow      @relation(fields: [rowId], references: [id], onDelete: Cascade)
  property DatabaseProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([rowId, propertyId])
  @@index([propertyId])
}

model DatabaseView {
  id         String           @id @default(cuid())
  databaseId String
  name       String
  type       DatabaseViewType
  config     Json?
  sortOrder  Int              @default(0)
  createdAt  DateTime         @default(now())

  database WikiDatabase @relation(fields: [databaseId], references: [id], onDelete: Cascade)

  @@index([databaseId])
}

model BlockComment {
  id              String    @id @default(cuid())
  pageId          String
  blockId         String
  authorId        String
  body            String
  resolved        Boolean   @default(false)
  parentCommentId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  page          WikiPage       @relation("WikiPageBlockComments", fields: [pageId], references: [id], onDelete: Cascade)
  author        User           @relation("BlockCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  parentComment BlockComment?  @relation("BlockCommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies       BlockComment[] @relation("BlockCommentReplies")

  @@index([pageId, blockId])
  @@index([authorId])
}

model WikiMention {
  id           String            @id @default(cuid())
  sourcePageId String
  targetType   MentionTargetType
  targetId     String            // userId, wikiPageId, or ISO date string
  blockId      String?           // BlockNote block id, for jump-to-context
  createdAt    DateTime          @default(now())

  sourcePage WikiPage @relation("WikiMentionSource", fields: [sourcePageId], references: [id], onDelete: Cascade)

  @@index([sourcePageId])
  @@index([targetType, targetId])
}

model AutomationRule {
  id             String       @id @default(cuid())
  name           String
  description    String?
  triggerType    String       // e.g., "STATUS_CHANGE", "PRIORITY_CHANGE"
  triggerValue   String       // e.g., "DONE", "P0" (The value that triggers the rule)
  actionType     String       // e.g., "ASSIGN_USER", "ADD_COMMENT"
  actionValue    String       // e.g., userId, "Great job!"
  isActive       Boolean      @default(true)
  
  projectId      String?
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  creatorId      String
  creator        User         @relation(fields: [creatorId], references: [id])
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([projectId])
  @@index([creatorId])
}

// ─── AI Chat History ─────────────────────────────────────

model AssistantMessage {
  id        String   @id @default(cuid())
  role      String   // "user" | "assistant"
  content   String   @db.Text
  metadata  Json?    // references to tasks/projects mentioned
  userId    String
  createdAt DateTime @default(now())

  user User @relation("AssistantMessageUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Project Milestones ──────────────────────────────────

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  MISSED
}

model Milestone {
  id             String          @id @default(cuid())
  title          String
  description    String?
  dueDate        DateTime
  status         MilestoneStatus @default(PENDING)
  projectId      String
  organizationId String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([organizationId])
}

model PrivacyRequest {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  kind           String
  status         String   @default("PENDING")
  details        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  completedAt    DateTime?

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([organizationId, createdAt])
}
